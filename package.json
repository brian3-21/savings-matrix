{
  "name": "savings-matrix",
  "version": "0.1.0",
  "description": "Generate square n x n matrices of multiples whose sum is exactly the total you ask for.",
  "license": "MIT",
  "author": "brian3-21",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brian3-21/savings-matrix.git"
  },
  "homepage": "https://github.com/brian3-21/savings-matrix#readme",
  "bugs": {
    "url": "https://github.com/brian3-21/savings-matrix/issues"
  },
  "keywords": [
    "matrix",
    "savings",
    "multiples",
    "stars-and-bars",
    "generator",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}